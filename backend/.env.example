# Copiá este archivo como "backend/.env" para cambiar la configuración (todo es opcional).

# Puerto de la API (y de la web compilada)
PORT=3000

# Política de contraseñas y bloqueo (US9)
PASSWORD_MIN_LENGTH=10
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15

# Sesión (US9): minutos sin actividad hasta que se cierra sola, y duración máxima en horas.
# Para mostrar la expiración en la demo se puede poner SESSION_IDLE_MINUTES=1
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12

# Enlaces de activación (US8): horas de validez y URL con la que se arman los enlaces de los correos
ACTIVATION_HOURS=72
# PUBLIC_URL=http://localhost:3000

# Correos: "desarrollo" (no salen; se ven en Panel FIA > Correos) o "smtp" (se envían de verdad)
MAIL_TRANSPORT=desarrollo
# MAIL_FROM=Plataforma FIA <no-responder@tu-dominio.com>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu-cuenta@gmail.com
# SMTP_PASS=contraseña-de-aplicación

# Costo de scrypt (2^N). 17 es el mínimo recomendado por OWASP; no conviene bajarlo fuera de los tests.
# SCRYPT_LOG_N=17
